# ── Flask ──
FLASK_SECRET_KEY=change-me-in-prod
FLASK_PORT=5000

# ── Base de datos (PostgreSQL) ──
DATABASE_NAME=asistencia
DATABASE_USER=asistencia
DATABASE_PASSWORD=change-me-in-prod
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ── JWT para URLs de QR ──
JWT_SECRET=change-me-in-prod

# ── URL pública (los QR codifican URLs completas /marcar/<jwt>) ──
APP_BASE_URL=http://localhost:5000

# ── Super admin inicial (se crea al primer arranque) ──
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=change-me-in-prod
SUPERADMIN_EMAIL=admin@asistencia.local
SUPERADMIN_NAME=Administrador